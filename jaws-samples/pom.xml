<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.hongxi</groupId>
        <artifactId>jaws-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>jaws-samples</artifactId>
    <packaging>pom</packaging>

    <modules>
        <module>jaws-sample-zk-provider</module>
        <module>jaws-sample-zk-consumer</module>
        <module>jaws-sample-nacos-provider</module>
        <module>jaws-sample-nacos-consumer</module>
        <module>jaws-sample-api</module>
        <module>jaws-sample-injvm</module>
        <module>jaws-sample-benchmark</module>
        <module>jaws-sample-boot-provider</module>
        <module>jaws-sample-boot-consumer</module>
        <module>jaws-sample-mcp</module>
        <module>jaws-sample-netty-provider</module>
        <module>jaws-sample-netty-consumer</module>
        <module>jaws-sample-stream-provider</module>
        <module>jaws-sample-stream-consumer</module>
        <module>jaws-sample-http2-provider</module>
        <module>jaws-sample-http2-consumer</module>
        <module>jaws-sample-gray</module>
    </modules>

    <dependencies>
        <!-- samples are runnable applications, provide a logging implementation -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.4</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>